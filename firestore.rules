
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global access for prototype - allow read/write to all collections
    // This resolves the "Missing or insufficient permissions" for list operations
    
    match /users/{userId} {
      allow read, write: if true;
    }

    match /gameSessions/{gameId} {
      allow read, write: if true;
      
      // Explicitly match subcollections to ensure "list" and "get" are allowed
      match /predictions/{predictionId} {
        allow read, write: if true;
      }
    }

    // Fallback for any other paths
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
