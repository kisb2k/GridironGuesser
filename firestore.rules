
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // GLOBAL PERMISSIVE RULES FOR PROTOTYPING
    // This allows any user (authenticated or guest) to perform any operation.
    // This is necessary to resolve "Missing or insufficient permissions" errors on list/get operations.
    
    match /{document=**} {
      allow read, write: if true;
    }

    // Explicitly allow list operations on the predictions subcollection for guests.
    // This is a redundant safety measure to ensure queries on this path are never blocked.
    match /gameSessions/{gameId}/predictions/{predictionId} {
      allow get, list, create, update, delete: if true;
    }
    
    // Forced deployment trigger: 1740420000000
  }
}
