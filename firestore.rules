
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ALLOW-ALL PROTOTYPE RULES
    // This provides unrestricted access to all collections and subcollections.
    // Necessary for the prototype to function for guest users without complex auth requirements.
    
    match /{document=**} {
      allow read, write: if true;
    }

    // Explicitly matching subcollections to ensure the 'list' method is permitted
    // for queries used in the Leaderboard and activity feeds.
    match /gameSessions/{gameId}/predictions/{predictionId} {
      allow read, write: if true;
    }
    
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Forced deployment trigger: 1740417645000
  }
}
