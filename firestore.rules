
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // GLOBALLY PERMISSIVE RULES FOR PROTOTYPING
    // This allows any user (authenticated or anonymous) to perform any operation.
    // It specifically resolves "Missing or insufficient permissions" on list/get operations
    // for collections and subcollections used in the app.
    
    match /{document=**} {
      allow read, write: if true;
    }

    // Forced deployment trigger to ensure rules are refreshed on the backend.
    // Timestamp: 1740423000000
  }
}
