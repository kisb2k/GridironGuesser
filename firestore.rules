
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ULTIMATE PROTOTYPE PERMISSIONS:
    // This allows anyone (authenticated or not) to read and write to any document.
    // This is necessary to resolve the persistent "Missing or insufficient permissions" 
    // errors for guests and unauthenticated leaderboard listing.
    
    match /{document=**} {
      allow read, write: if true;
    }

    // Explicitly matching the predictions subcollection for extra clarity to the rules engine
    // and to ensure list operations are permitted even when auth is null.
    match /gameSessions/{gameId}/predictions/{predictionId} {
      allow read, write: if true;
    }
    
    // Deployment trigger: 1716552000000
  }
}
