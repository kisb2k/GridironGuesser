
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // REDEPLOYMENT TRIGGER: Rule update for subcollection listing permissions.
    
    // Explicitly allow access to the game sessions and all their sub-data (predictions, etc.)
    // This ensures that the 'list' method works even for unauthenticated users (auth == null).
    match /gameSessions/{gameId} {
      allow read, write: if true;
      
      match /predictions/{predictionId} {
        allow read, write: if true;
      }
      
      // Recursive match for any other nested data
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Explicitly allow access to user profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Catch-all global access for the prototype
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
