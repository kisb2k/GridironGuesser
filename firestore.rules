
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user is the admin of a session
    function isSessionAdmin(gameId) {
      return request.auth != null && get(/databases/$(database)/documents/gameSessions/$(gameId)).data.adminUid == request.auth.uid;
    }

    // Helper for user ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if true; // Simplified for prototype login flow
    }

    match /gameSessions/{gameId} {
      allow read: if true;
      allow create: if true; // Any logged in user can start a session
      allow update, delete: if true; // Simplified for admin management in prototype
      
      match /predictions/{predictionId} {
        allow read: if true;
        allow write: if true; // Allow fans to lock in predictions
      }
    }
  }
}
