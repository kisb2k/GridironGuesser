
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user profile and their game stats.",
      "properties": {
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["USER", "ADMIN"] },
        "points": { "type": "number" },
        "streak": { "type": "number" },
        "password": { "type": "string" },
        "isGuest": { "type": "boolean" }
      },
      "required": ["displayName", "role"]
    },
    "GameSession": {
      "title": "GameSession",
      "type": "object",
      "description": "A live game instance managed by an admin.",
      "properties": {
        "adminUid": { "type": "string" },
        "sport": { "type": "string", "enum": ["FOOTBALL", "CRICKET", "BASEBALL", "HOCKEY", "SOCCER"] },
        "status": { "type": "string", "enum": ["PREDICTING", "LOCKDOWN", "RESOLVING", "COMPLETED"] },
        "controlMode": { "type": "string", "enum": ["MANUAL", "LIVE"] },
        "situation": { "type": "string" },
        "scoreAway": { "type": "number" },
        "scoreHome": { "type": "number" },
        "timeRemaining": { "type": "string" },
        "currentPlayId": { "type": "string" },
        "lastResult": { "type": "object" }
      }
    },
    "Prediction": {
      "title": "Prediction",
      "type": "object",
      "description": "A user's prediction for a specific play in a game session.",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "playId": { "type": "string" },
        "playType": { "type": "string" },
        "outcome": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles. Owners can read/write."
    },
    "/gameSessions/{gameId}": {
      "schema": { "$ref": "#/entities/GameSession" },
      "description": "Live game sessions. Public read, admin write."
    },
    "/gameSessions/{gameId}/predictions/{predictionId}": {
      "schema": { "$ref": "#/entities/Prediction" },
      "description": "Predictions for a specific game. Owners can write, everyone can read."
    }
  }
}
